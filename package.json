{
  "name": "elite-studio",
  "productName": "Elite Studio",
  "version": "1.0.0",
  "description": "Elite Studio music player with DJ mode",
  "main": "main.js",
  "author": "Elite Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "lamejs": "1.2.1",
    "jsmediatags": "3.9.7"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elitestudio.app",
    "productName": "Elite Studio",
    "files": [
      "main.js",
      "preload.js",
      "island-preload.js",
      "index.html",
      "island.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    }
  }
}